        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreditCheckReport"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Город, ниша или данные не найдены"
          },
          "422": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Параметры расчёта некорректны"
          }
        },
        "summary": "Проверка бизнес-плана заявки на кредит",
        "tags": [
          "v2"
        ]
      }
    },
